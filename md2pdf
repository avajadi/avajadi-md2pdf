#!/usr/bin/env bash
# Runs avajadi-md2pdf as a one-off Docker container - no local pandoc, Chromium or
# Node needed, only Docker. Forked from rise-md2pdf's md2rise wrapper.
#
# There is no registry: the image is built locally from this directory the first time
# it's needed, and tagged avajadi-md2pdf:latest. After changing the CSS, fonts or
# scripts, rebuild it with
#
#   md2pdf --rebuild
#
# AVAJADI_MD2PDF_IMAGE overrides the image reference, e.g. to try a differently
# tagged build.
#
# Usage: md2pdf [--] <file.md> [file.md ...]
#        md2pdf --rebuild
#        md2pdf -h | --help | --version
#
# Files can live anywhere on the filesystem, not just under the current
# directory - each file's own directory is mounted at the same path it has on
# the host (see below), so no paths need rewriting between host and container.
set -euo pipefail

IMAGE="${AVAJADI_MD2PDF_IMAGE:-avajadi-md2pdf:latest}"
PROG="$(basename "$0")"

# The repo directory, found through any chain of symlinks (md2pdf is meant to be
# symlinked onto PATH), since that's the Docker build context. Plain readlink, since
# `readlink -f` is GNU-only and macOS lacks `realpath`.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in
    /*) src="$target" ;;
    *)  src="$(dirname "$src")/$target" ;;
  esac
done
TOOLS="$(cd "$(dirname "$src")" && pwd)"

# The wrapper's version is version.txt in the checkout it lives in. Guarded, so a copy
# outside the checkout says "unknown" instead of failing.
wrapper_version() {
  local v=""
  [ -f "$TOOLS/version.txt" ] && v="$(tr -d '[:space:]' < "$TOOLS/version.txt")"
  echo "${v:-unknown}"
}

build_image() {
  docker build --build-arg VERSION="$(wrapper_version)" -t "$IMAGE" "$TOOLS"
}

usage() {
  cat <<EOF
Usage: $PROG [--] <file.md> [file.md ...]
       $PROG --rebuild
       $PROG -h | --help | --version

Convert Markdown files to an avajadi-formatted PDF (.pdf), written next to each source
file. Runs in a one-off Docker container; only Docker is needed locally. The image is
built from $TOOLS on first use.

Options:
  -h, --help     show this help and exit
      --version  print the version and the Docker image in use, then exit
      --rebuild  rebuild the image (after changing CSS, fonts or scripts), then exit
  --             end of options; every later argument is a file name

Environment:
  AVAJADI_MD2PDF_IMAGE  image reference to build and run instead of
                        avajadi-md2pdf:latest

Current image: $IMAGE
EOF
}

version() {
  local image_v
  echo "$PROG $(wrapper_version) (avajadi-md2pdf)"
  # A built image carries its own version label; it may differ from this checkout's
  # version.txt if the image wasn't rebuilt after a bump. Never build just for this.
  if image_v="$(docker image inspect \
      --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
      "$IMAGE" 2>/dev/null)"; then
    # Images built before the label existed, or by a plain `docker build`, say nothing.
    echo "image:   $IMAGE (version ${image_v:-unknown, image has no version label})"
  else
    echo "image:   $IMAGE (not built yet)"
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)  usage; exit 0 ;;
    --version)  version; exit 0 ;;
    --rebuild)  build_image; exit 0 ;;
    --)         shift; break ;;
    -?*)
      echo "$PROG: unknown option: $1" >&2
      echo "Try '$PROG --help' for more information." >&2
      exit 2
      ;;
    *) break ;;
  esac
done

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "$IMAGE not found locally, building it from $TOOLS" >&2
  build_image >&2
fi

# Resolve each argument to an absolute host path and collect every unique
# directory that needs mounting. The whole directory is mounted (not just the
# file), since build.sh writes its output next to the source file. Each
# directory is mounted at the exact same path inside the container as
# outside, so the arguments can be passed through unchanged.
abs_files=()
mount_dirs=()

have_dir() {
  local needle="$1"; shift
  for d in "$@"; do [ "$d" = "$needle" ] && return 0; done
  return 1
}

for f in "$@"; do
  [ -f "$f" ] || { echo "missing: $f" >&2; exit 1; }
  dir="$(cd "$(dirname "$f")" && pwd)"
  abs_files+=("$dir/$(basename "$f")")
  have_dir "$dir" "${mount_dirs[@]-}" || mount_dirs+=("$dir")
done

mount_args=()
for dir in "${mount_dirs[@]}"; do
  mount_args+=(-v "$dir:$dir")
done

docker run --rm \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  "${mount_args[@]}" \
  "$IMAGE" "${abs_files[@]}"
